# Environment Configuration for Prior Authorization Agent
# LLM Provider: 'deterministic' (zero key / offline test mode), 'openai', 'gemini', or 'anthropic'
LLM_PROVIDER=deterministic

# API Key for remote LLM calls (leave blank if LLM_PROVIDER=deterministic)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Prior Auth API Security
API_KEY=dev-prior-auth-key
REQUIRE_API_KEY=false

# Service Ports & URLs
API_PORT=8000
UI_PORT=8501
API_BASE_URL=http://localhost:8000

# Database Configuration (defaults to local SQLite; uncomment for PostgreSQL)
DATABASE_URL=sqlite:///prior_auth.db
# DATABASE_URL=postgresql://priorauth:priorauthpass@localhost:5432/prior_auth

# Data Directories
POLICIES_DIR=data/policies
SYNTHETIC_DATA_PATH=data/synthetic_notes.jsonl
CRITERIA_CACHE_DIR=data/cache/criteria

